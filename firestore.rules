rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helper: check if the caller is an authenticated admin.
    //
    // Admin UIDs are stored in a config document at:
    //   app_config/admin_users  →  { uids: ["uid1", "uid2", ...] }
    //
    // This avoids hardcoding UIDs in the rules file itself.
    // To bootstrap: create that document manually in the Firebase console
    // before deploying these rules.
    // =====================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/app_config/admin_users).data.uids;
    }

    // =====================================================================
    // Default: deny everything not explicitly allowed
    // =====================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =====================================================================
    // Admin config document (self-referencing — only admins can read/write)
    // =====================================================================
    match /app_config/admin_users {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // =====================================================================
    // wa_bot/{waId} — root document
    // Fields: is_bot_active, default_bot_active_for_new_contacts
    // =====================================================================
    match /wa_bot/{waId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();

      // -------------------------------------------------------------------
      // contact/{sender} — address book
      // -------------------------------------------------------------------
      match /contact/{sender} {
        allow read:  if isAuthenticated();
        allow write: if isAdmin();
      }

      // -------------------------------------------------------------------
      // chat/{userPhone} — chat metadata (includes bot_active, custom_prompt_id)
      // -------------------------------------------------------------------
      match /chat/{userPhone} {
        allow read:  if isAuthenticated();
        allow write: if isAdmin();

        // messages/{messageId} — individual chat messages
        match /messages/{messageId} {
          allow read:  if isAuthenticated();
          allow write: if isAdmin();
        }

        // status/{messageId} — status/story messages per contact
        match /status/{messageId} {
          allow read:  if isAuthenticated();
          allow write: if isAdmin();
        }
      }

      // -------------------------------------------------------------------
      // prompts/{promptId} — prompt library (new, PRD §8)
      // -------------------------------------------------------------------
      match /prompts/{promptId} {
        allow read:  if isAuthenticated();
        allow write: if isAdmin();
      }

      // -------------------------------------------------------------------
      // custom_prompts/{userPhone} — legacy per-contact prompts
      // -------------------------------------------------------------------
      match /custom_prompts/{userPhone} {
        allow read:  if isAuthenticated();
        allow write: if isAdmin();
      }

      // -------------------------------------------------------------------
      // daily_plans/{userPhone}/plans/{date} — AI daily plans
      // -------------------------------------------------------------------
      match /daily_plans/{userPhone} {
        allow read:  if isAuthenticated();
        // No admin writes needed — generated by the Go backend

        match /plans/{date} {
          allow read:  if isAuthenticated();
        }
      }

      // -------------------------------------------------------------------
      // status_feed/{messageId} — flat status feed
      // -------------------------------------------------------------------
      match /status_feed/{messageId} {
        allow read:  if isAuthenticated();
        // Written by the Go backend, not the admin app
      }
    }

    // =====================================================================
    // wa_bot/recent-chat/all/{autoId} — outgoing message queue
    //
    // This sits outside the {waId} partition. The admin app may write here
    // in Phase 2 (manual reply). For now, read-only for the admin.
    // =====================================================================
    match /wa_bot/recent-chat/all/{autoId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // =====================================================================
    // customer_support/{tokenId} — FCM push tokens (out of scope for v1)
    // =====================================================================
    match /customer_support/{tokenId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
